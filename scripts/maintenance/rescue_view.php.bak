            <div class="form-group">
                <label>ตำแหน่งที่ต้องการ (Target Role)</label>
                <select name="role">
                    <option value="admin">Admin (ผู้ดูแลระบบ)</option>
                    <option value="executive">Executive (ฝ่ายบริหาร)</option>
                    <option value="teacher">Teacher (คุณครู)</option>
                </select>
            </div>

            <button type="submit">ยืนยันการยกระดับสัญชาติ Role</button>
        </form>

        <div class="footer">
