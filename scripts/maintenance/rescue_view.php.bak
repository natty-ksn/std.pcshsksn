            transition: all 0.3s;
            background-color: #ffffff !important;
            color: #1e293b !important;
        }
        input::placeholder { color: #94a3b8; }
        input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); background-color: #ffffff !important; }
        
        button {
            width: 100%;
